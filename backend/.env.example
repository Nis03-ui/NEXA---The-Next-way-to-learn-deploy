APP_NAME=NEXA API
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./nexa.db
# PostgreSQL example: postgresql+asyncpg://postgres:postgres@localhost:5432/nexa
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key-here

# Email / SMTP (use a Gmail App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
SMTP_FROM_NAME=NEXA
\n\n# Resend transactional email\nRESEND_API_KEY=your-resend-api-key\nRESEND_FROM_EMAIL=NEXA <no-reply@your-verified-domain.com>\n

# Google Drive cloud storage
# Create a Google Cloud service account, enable the Google Drive API,
# share the target Drive folder with the service-account email, and store
# the service-account JSON as a single-line JSON value in Render.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account", "...":"..."}
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
